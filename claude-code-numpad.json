{
  "title": "Claude Code agent layer (hold Caps Lock) + AgentHUD picker",
  "rules": [
    {
      "description": "Caps Lock: hold = agent layer, tap = Caps Lock",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "caps_lock",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "agent_layer",
                "value": 1
              }
            }
          ],
          "to_after_key_up": [
            {
              "set_variable": {
                "name": "agent_layer",
                "value": 0
              }
            }
          ],
          "to_if_alone": [
            {
              "key_code": "caps_lock"
            }
          ]
        }
      ]
    },
    {
      "description": "Agent layer, any app: Num 5 = open/close the Claude session picker (AgentHUD)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "keypad_5"
          },
          "to": [
            {
              "shell_command": "open -a ~/Applications/AgentHUD.app"
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "agent_layer",
              "value": 1
            }
          ]
        }
      ]
    },
    {
      "description": "Agent layer, in terminals/editors: numpad -> Claude Code actions",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "keypad_1"
          },
          "to": [
            {
              "key_code": "1"
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "agent_layer",
              "value": 1
            },
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.apple\\.Terminal$",
                "^com\\.googlecode\\.iterm2$",
                "^com\\.mitchellh\\.ghostty$",
                "^dev\\.warp\\.Warp",
                "^com\\.microsoft\\.VSCode$",
                "^com\\.todesktop\\.230313mzl4w4u92$",
                "^com\\.anthropic\\.claudefordesktop$"
              ]
            }
          ]
        },
